+            ctx.data_mut(|data| data.insert_temp(marker, true));
+        }
+        if ctx.data(|data| data.get_temp::<usize>(egui::Id::new("qa-transition-index"))).unwrap_or(0) == 0 {Some(first)} else {Some(second)}
